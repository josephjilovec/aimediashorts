# Google Cloud Project OAuth 2.0 Credentials
# Obtain from https://console.cloud.google.com/apis/credentials (Desktop App type)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_PROJECT_ID=your_project_id_here
GOOGLE_REFRESH_TOKEN=

# Local Ollama AI Settings (Free local multimodal vision)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=gemma4:e2b

# Optional: Path overrides (leave blank to auto-detect from Desktop and mounted Google Drive)
MEDIA_WORKSPACE_DIR=
GDRIVE_INBOX_DIR=
FFMPEG_BINARY_PATH=
